void playMidi(int pin, const int notes[][3], size_t len){
 for (int i = 0; i < len; i++) {
    tone(pin, notes[i][0]);
    delay(notes[i][1]);
    noTone(pin);
    delay(notes[i][2]);
  }
}
// Generated using https://github.com/ShivamJoker/MIDI-to-Arduino

// main.ino or main.cpp
void setup() {
  pinMode(boton1, INPUT_PULLUP);
  pinMode(boton2, INPUT_PULLUP);
  pinMode(boton3, INPUT_PULLUP);
}

void loop() {
   if (digitalRead(boton1) == LOW)
  {
    playMidi(8, midi1, ARRAY_LEN(midi1));

    while (digitalRead(boton1) == LOW);
    delay(200);
  }

  if (digitalRead(boton2) == LOW)
  {
    playMidi(8, midi2, ARRAY_LEN(midi2));

    while (digitalRead(boton2) == LOW);
    delay(200);
  }
  
  if (digitalRead(boton3) == LOW)
  {
    playMidi(8, midi3, ARRAY_LEN(midi3));

    while (digitalRead(boton3) == LOW);
    delay(200);
  }
}